# PostgreSQL connection (docker-compose provides a local instance on host port 5433).
# Start it with: docker compose up -d postgres
DATABASE_URL="postgresql://vtirs:vtirs_dev_password@localhost:5433/vtirs?schema=public"

# JWT secret for signing auth tokens (change in production!)
JWT_SECRET="change-me-to-a-long-random-secret"

# File upload storage location (fallback when S3 is not configured).
# Storage uses the configured S3-compatible endpoint when these are set;
# otherwise files fall back to UPLOAD_DIR on the local filesystem.
UPLOAD_DIR="./uploads"

# Force local-disk storage for development, even when S3 credentials are
# present in the environment (e.g. a shared root .env.local). Prevents a
# local server from ever reading/writing the production bucket.
STORAGE_MODE="local"

# Set to "true" ONLY in environments whose database owns the bucket, to let
# the nightly storage-orphan-sweep delete unreferenced blobs. Any other value
# (or unset) makes the sweep log-only. Never enable alongside a scratch DB.
# STORAGE_SWEEP_ENABLED="false"

# Neon Object Storage (S3-compatible). Get these from your Neon branch.
# AWS_ACCESS_KEY_ID="nak_..."
# AWS_SECRET_ACCESS_KEY="nsk_..."
# AWS_ENDPOINT_URL_S3="https://<branch>.storage.<region>.aws.neon.tech"
# AWS_REGION="us-east-2"
# STORAGE_BUCKET="documents"

# App
APP_NAME="VTIRS"
ORG_NAME="Dashen Bank"
